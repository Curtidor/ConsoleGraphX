## Ignore ALL Visual Studio files, temporary files, build results,
## and files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# === FULL VISUAL STUDIO IGNORE BLOCK ===

# Solution and project files
*.sln
*.suo
*.vcxproj
*.vcxproj.*
*.vcproj
*.vcproj.*
*.vcxproj.filters
*.vcxproj.user

#python
# Ignore JetBrains IDE (PyCharm, CLion, IntelliJ, etc.) project settings
.idea/


# User-specific files
*.rsuser
*.user
*.userosscache
*.sln.docstates
*.DotSettings*
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# MonoDevelop/Xamarin Studio
*.userprefs

# Cache and temp files
*.cachefile
*.log
*.tmp
*.bak
~$*
*~

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]*/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio IDE settings and options
.vs/
Generated\ Files/
ipch/
_ReSharper*/
*.[Rr]e[Ss]harper

# Visual Studio profiler and coverage
*.psess
*.vsp
*.vspx
*.coverage
*.coveragexml
*.sap

# MSTest, NUnit, and test logs
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

